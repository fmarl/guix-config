defaults
auth    on
tls     on
logfile ~/.local/state/msmtp/msmtp.log

account     mailbox
from        "Florian Marrero Liestmann <f.m.liestmann@fx-ttr.de>"
user        f.m.liestmann@fx-ttr.de
passwordeval "~/.local/bin/secret mailbox-password"
host	smtp.mailbox.org
port    587
tls_starttls on

account default : mailbox