defaults
auth    on
tls     on
logfile ~/.msmtp.log

account     mailbox
from        "Florian Marrero Liestmann <f.m.liestmann@fx-ttr.de>"
user        f.m.liestmann@fx-ttr.de
passwordeval "age -d -i $HOME/.config/sops/age/keys.txt $HOME/.mailbox.age"
host	smtp.mailbox.org
port    587
tls_starttls on

account default : mailbox