account      default
host         smtp.mailbox.org
port         465
tls          on
tls_starttls off
auth         on
from         f.m.liestmann@fx-ttr.de
user         f.m.liestmann@fx-ttr.de
passwordeval "~/.local/bin/secret mailbox-password"
logfile      ~/.local/state/msmtp/msmtp.log
