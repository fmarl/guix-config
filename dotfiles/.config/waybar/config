// -*- mode: javascript -*-

[
    {
	"height": 5,
	"modules-left": [
	    "river/tags",
	    "niri/workspaces"
	],
	"modules-center": [
	    "river/window",
	    "niri/window"
	],
	"modules-right": [
	    "network",
	    "memory",
	    "cpu",
	    "battery",
	    "clock",
	    "tray"
	],
	"battery": {
	    "bat": "BAT0",
	    "format": "{capacity}% {icon}",
	    "format-alt": "{time} {icon}",
	    "format-charging": "{capacity}% ",
	    "format-icons": [
		"",
		"",
		"",
		"",
		""
	    ],
	    "format-plugged": "{capacity}% ",
	    "states": {
		"critical": 15,
		"warning": 30
	    }
	},
	"clock": {
	    "format": "{:%a %d.%m %H:%M}",
	    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
	},
	"cpu": {
	    "format": "{usage}% "
	},
	"disk": {
	    "format": "Disk {percentage_used:2}%",
	    "interval": 5,
	    "path": "/"
	},
	"memory": {
	    "format": "{}% "
	},
	"network": {
	    "format-alt": "{bandwidthDownBits}/{bandwidthUpBits}",
	    "format-disconnected": "Disconnected ",
	    "format-ethernet": "Ethernet ",
	    "format-linked": "Ethernet (No IP) ",
	    "format-wifi": "({signalStrength}%) "
	},
	"river/tags": {
	    "num-tags": 9
	},
	"river/window": {
	    "format": {}
	},
	"niri/workspaces": {
	    
	},
	"niri/window": {
	    
	},
	"tray": {
	    "spacing": 10
	}
    }
]
