// -*- mode: javascript -*-

[
    {
	"layer": "top",
	"position": "top",
	"height": 26,
	"spacing": 10,

	"modules-left": [
            "niri/workspaces"
	],

	"modules-center": [
            "clock"
	],

	"modules-right": [
            "network",
            "battery"
	],

	"river/tags": {
            "num-tags": 9
	},

	"clock": {
            "format": "{:%a %d %b %H:%M}",
            "tooltip-format": "<tt>{calendar}</tt>"
	},

	"network": {
            "interval": 2,

            "format-wifi": "{essid} ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
            "format-ethernet": "eth ↑{bandwidthUpBytes} ↓{bandwidthDownBytes}",
            "format-linked": "link",
            "format-disconnected": "offline",

            "tooltip-format": "{ifname}\n{ipaddr}\n{gwaddr}"
	},

	"battery": {
            "interval": 15,

            "states": {
		"warning": 25,
		"critical": 10
            },

            "format": "BAT {capacity}% · {time}",
            "format-charging": "AC {capacity}% · {time}",
            "format-plugged": "AC {capacity}%",
            "tooltip": true,
            "tooltip-format": "{capacity}%\n{power:.1f} W\n{cycles} cycles"
	}
    }
]

