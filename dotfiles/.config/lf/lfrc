set hidden
set dirfirst
set sortby name
set previewer ~/.config/lf/preview

map gg top
map G bottom

map D delete
map yy copy
map pp paste
map rr rename

cmd fzf_select ${{
    res="$(fzf)"
    [ -n "$res" ] || exit 0
    res="$(printf '%s' "$res" | sed 's/\\/\\\\/g; s/"/\\"/g')"
    lf -remote "send $id select \"$res\""
}}

map f fzf_select
