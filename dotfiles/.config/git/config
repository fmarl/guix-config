[user]
email = "f.m.liestmann@fx-ttr.de"
name = "Florian Marrero Liestmann"
signingKey = "D1912EEBC3FBEBB4"

[commit]
gpgSign = true

[core]
editor = "emacsclient -s emacs-daemon -t -a ''"
whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol	
autocrlf = false
safecrlf = true

[log]
abbrevCommit = true

[pull]
rebase = true

[tag]
gpgSign = true

[diff]
renames = copies
algorithm = patience
context = 3

[format]
subjectprefix = PATCH
signoff = true
numbered = auto
headers = "Content-Type: text/plain; charset=UTF-8"

[sendemail]
smtpserver = /usr/bin/msmtp
smtpserveroption = -a default
from = f.m.liestmann@fx-ttr.de
chainreplyto = false
confirm = always
annotate = yes
suppresscc = self
to = linux-kernel@vger.kernel.org

[alias]
co = checkout
st = status
ci = commit
br = branch
lg = log --graph --oneline --decorate --all

[color]
ui = auto	